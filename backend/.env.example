# Copy this file to backend/.env and fill in the values.

# --- MySQL / MariaDB ---------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306            # XAMPP/MariaDB setups often use 3307; set whatever your server listens on
DB_USER=root
DB_PASSWORD=
DB_NAME=fleet_db

# --- API ---------------------------------------------------------------------
PORT=5000
CLIENT_ORIGIN=http://localhost:5173     # exact origin of the React app (CORS + WebSocket)

# --- Secrets (use long random values; never commit the real .env) ------------
JWT_SECRET=change-me-to-a-long-random-string
SIMULATOR_SECRET=change-me-too

# --- Cookies -----------------------------------------------------------------
# Local demo: leave these two lines out (SameSite=Strict, Secure only when NODE_ENV=production).
# Cloud deployment with the frontend and API on different sites (HTTPS required):
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true

# --- First administrator (used by: npm run seed:admin) -----------------------
ADMIN_EMAIL=admin@abu.edu.ng
ADMIN_PASSWORD=change-this-password
